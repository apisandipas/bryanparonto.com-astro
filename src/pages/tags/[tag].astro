---
import Buffer from "../../layouts/Buffer.astro";
import { getTags, orgDate, type Post } from "../../lib/content";

export async function getStaticPaths() {
  const tags = await getTags();
  return [...tags].map(([tag, posts]) => ({ params: { tag }, props: { posts } }));
}
const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
---
<Buffer
  title={`:${tag}: — Bryan Paronto`}
  description={`Posts tagged ${tag} by Bryan Paronto.`}
  buffer={`writing.org::${tag}`}
  back
>
  <header class="doc-header">
    <div class="kw" aria-hidden="true">#+FILTER: tag</div>
    <h1 class="page-title"><span class="deco" aria-hidden="true">:</span>{tag}<span class="deco" aria-hidden="true">:</span></h1>
    <p class="faded">{posts.length} {posts.length === 1 ? "post" : "posts"}. <a href="/blog">All posts</a></p>
  </header>
  <ol class="agenda">
    {posts.map((p) => (
      <li>
        <span class="ts"><span class="deco" aria-hidden="true">&lt;</span><time datetime={p.date.toISOString().slice(0, 10)}>{orgDate(p.date)}</time><span class="deco" aria-hidden="true">&gt;</span></span>
        <a class="title" href={`/blog/${p.slug}`}>{p.title}</a>
      </li>
    ))}
  </ol>
</Buffer>
