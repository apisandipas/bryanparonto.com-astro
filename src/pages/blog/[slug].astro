---
import Buffer from "../../layouts/Buffer.astro";
import { getPosts, orgDate, type Post } from "../../lib/content";
import { person } from "../../data/resume";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const iso = post.date.toISOString().slice(0, 10);
---
<Buffer
  title={`${post.title} — Bryan Paronto`}
  description={post.excerpt}
  buffer={`${post.slug}.org`}
  back
  type="article"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    datePublished: iso,
    author: { "@type": "Person", name: person.name, url: person.site },
    keywords: post.tags.join(", "),
  }}
>
  <article>
    <header class="doc-header">
      <div class="kw" aria-hidden="true">#+TITLE:</div>
      <h1 class="page-title">{post.title}</h1>
      <dl class="doc-meta">
        <dt>Date</dt>
        <dd class="ts"><span class="deco" aria-hidden="true">&lt;</span><time datetime={iso}>{orgDate(post.date)}</time><span class="deco" aria-hidden="true">&gt;</span></dd>
        <dt>Tags</dt>
        <dd class="tags"><span aria-hidden="true">:</span>{post.tags.map((t, i) => (
          <><a class="tag-link" href={`/tags/${t}`}>{t}</a><span aria-hidden="true">:</span>{i < post.tags.length - 1 && <span class="visually-hidden">, </span>}</>
        ))}</dd>
        <dt>Read</dt>
        <dd>{post.minutes} min</dd>
      </dl>
    </header>
    <div class="prose" set:html={post.html} />
  </article>
  <nav class="post-nav" aria-label="More posts">
    <div>{older && <a href={`/blog/${older.slug}`}><span class="label">← older</span>{older.title}</a>}</div>
    <div class="next">{newer && <a href={`/blog/${newer.slug}`}><span class="label">newer →</span>{newer.title}</a>}</div>
  </nav>
</Buffer>
